{
	"schemaVersion": 1,
	"id": "packconverter",
	"version": "${version}",
	"name": "Pack Converter",
	"description": "Old resource packs on 1.21.11, with close to instant pack loads, pack folders and pack previews",
	"authors": [
		"xarlaq"
	],
	"license": "GPL-3.0-only",
	"icon": "assets/packconverter/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.packconverter.PackConverterClient"
		],
		"modmenu": [
			"dev.packconverter.mc.ui.ModMenuIntegration"
		]
	},
	"accessWidener": "packconverter.classtweaker",
	"mixins": [
		{
			"config": "packconverter.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
